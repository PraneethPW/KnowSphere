# Neon pooled connection string; keep TLS enabled. Never put this in frontend env.
DATABASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_EXTRACTION_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_EXTRACTION_FALLBACKS=dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
SESSION_DAYS=7
MAX_UPLOAD_BYTES=10000000
MAX_DOCUMENT_CHARS=120000
MAX_DOCUMENTS_PER_SPACE=200
MAX_SPACES_PER_USER=10
WORKER_POLL_SECONDS=2
LOG_LEVEL=INFO
