# Local Docker database from compose.yaml. For Neon, replace with a pooled TLS URL.
# Never put this value in frontend env or commit your real .env.
DATABASE_URL=postgresql://knowsphere:knowsphere-local-only@127.0.0.1:54329/knowsphere
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_REASONING=false
OPENROUTER_FALLBACKS=xingchen-agi/xing4.0-29b-a4b:free,nvidia/nemotron-3.5-super-vl:free
OPENROUTER_EXTRACTION_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_EXTRACTION_REASONING=false
OPENROUTER_EXTRACTION_FALLBACKS=xingchen-agi/xing4.0-29b-a4b:free,nvidia/nemotron-3.5-super-vl:free
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
SESSION_DAYS=7
MAX_UPLOAD_BYTES=10000000
MAX_DOCUMENT_CHARS=120000
MAX_DOCUMENTS_PER_SPACE=200
MAX_SPACES_PER_USER=10
WORKER_POLL_SECONDS=2
LOG_LEVEL=INFO

# Local CPU relevance model. Run python -m knowsphere.prepare_ml before the API.
# Weights are pinned in knowsphere/ml_manifest.json; no Hugging Face key is needed.
ML_ENABLED=true
ML_CANDIDATES=32
ML_THREADS=2
# Optional custom prepared directory. Leave unset to use backend/models/minilm-reranker.
# ML_MODEL_DIR=
